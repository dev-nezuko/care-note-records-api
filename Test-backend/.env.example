# SQLite file shared by the API and seed_demo.py. Relative paths resolve from
# the working directory. The Docker image always uses /data/carenotes.db.
CARE_NOTES_DB_PATH=carenotes.db

# Comma-separated browser origins allowed to call the API.
CARE_NOTES_CORS_ORIGINS=http://localhost:3000

# Host port published by docker compose.
API_PORT=8000
